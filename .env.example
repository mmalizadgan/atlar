SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

DB_NAME=atlar_db
DB_USER=atlar_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

OTP_CODE_LENGTH=5
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=90
OTP_MAX_ATTEMPTS=5

# 'console' prints the OTP code to the terminal/log instead of sending a real SMS.
# Switch to a real provider once you have one (see accounts/services/sms.py).
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_LINE=

# Fill these in once Bale Pay is activated for your bazoo via @botfather in Bale.
BALE_PAY_MERCHANT_ID=
BALE_PAY_API_KEY=
SITE_BASE_URL=http://127.0.0.1:8000
